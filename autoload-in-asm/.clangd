CompileFlags:
  Add:
    - -xc
    - -std=c99
    - -DHOST_TEST
    - -Wno-unknown-attributes
    - -Wno-gcc-compat
    - -Wno-unused-value
    - -Wno-unused-function
Diagnostics:
  ClangTidy:
    Remove:
      - bugprone-infinite-loop
      - bugprone-too-small-loop-variable
      - misc-use-internal-linkage
  Suppress:
    - asm_invalid_input_constraint
    - asm_invalid_output_constraint
