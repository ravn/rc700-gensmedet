; OPEN_WORKSTATION intout, one-based indices per GSX/DRI skeleton.
; Advertised capabilities, not proof that every operation works.
DEV_TAB:
	dw	559                             ; 1 Maximum X coordinate (560 pixels, origin 0).
	dw	255                             ; 2 Maximum Y coordinate (256 pixels, origin 0).
	dw	1                               ; 3 Coordinate precision: 0 exact, 1 not exact.
	dw	392                             ; 4 Pixel width in micrometers.
	dw	578                             ; 5 Pixel height in micrometers.
	dw	232                             ; 6 Number of character heights.
	dw	7                               ; 7 Number of line styles.
	dw	1                               ; 8 Number of line widths.
	dw	5                               ; 9 Number of marker types.
	dw	232                             ; 10 Number of marker sizes.
	dw	1                               ; 11 Number of text fonts.
	dw	6                               ; 12 Number of area patterns.
	dw	6                               ; 13 Number of crosshatch patterns.
	dw	2                               ; 14 Number of simultaneous colors.
	dw	1                               ; 15 Number of supported GDPs.
	dw	1                               ; 16 GDP slot 1: function 1, filled rectangle (bar).
	dw	-1                              ; 17 GDP slot 2: unused.
	dw	-1                              ; 18 GDP slot 3: unused.
	dw	-1                              ; 19 GDP slot 4: unused.
	dw	-1                              ; 20 GDP slot 5: unused.
	dw	-1                              ; 21 GDP slot 6: unused.
	dw	-1                              ; 22 GDP slot 7: unused.
	dw	-1                              ; 23 GDP slot 8: unused.
	dw	-1                              ; 24 GDP slot 9: unused.
	dw	-1                              ; 25 GDP slot 10: unused.
	dw	3                               ; 26 GDP slot 1 attribute class: fill area.
	dw	-1                              ; 27 GDP slot 2 attribute class: unused.
	dw	-1                              ; 28 GDP slot 3 attribute class: unused.
	dw	-1                              ; 29 GDP slot 4 attribute class: unused.
	dw	-1                              ; 30 GDP slot 5 attribute class: unused.
	dw	-1                              ; 31 GDP slot 6 attribute class: unused.
	dw	-1                              ; 32 GDP slot 7 attribute class: unused.
	dw	-1                              ; 33 GDP slot 8 attribute class: unused.
	dw	-1                              ; 34 GDP slot 9 attribute class: unused.
	dw	-1                              ; 35 GDP slot 10 attribute class: unused.
	dw	1                               ; 36 Color capability.
	dw	1                               ; 37 Text rotation supported.
	dw	1                               ; 38 Polygon fill supported.
	dw	0                               ; 39 Cell-array inquiry not supported.
	dw	4                               ; 40 Palette entries, not bitmap planes.
	dw	1                               ; 41 Number of locator input devices.
	dw	1                               ; 42 Number of valuator input devices.
	dw	1                               ; 43 Number of choice input devices.
	dw	1                               ; 44 Number of string input devices.
	dw	2                               ; 45 Workstation type: input and output.

; OPEN_WORKSTATION ptsout: six coordinate pairs in device units.
; One-based word indices; zero components are not padding.
SIZ_TAB:
	dw	0                               ; 1 Minimum character size: X component.
	dw	7                               ; 2 Minimum character height.
	dw	0                               ; 3 Maximum character size: X component.
	dw	210                             ; 4 Maximum character height.
	dw	1                               ; 5 Minimum line width.
	dw	0                               ; 6 Minimum line size: Y component.
	dw	1                               ; 7 Maximum line width.
	dw	0                               ; 8 Maximum line size: Y component.
	dw	0                               ; 9 Minimum marker size: X component.
	dw	6                               ; 10 Minimum marker height.
	dw	0                               ; 11 Maximum marker size: X component.
	dw	180                             ; 12 Maximum marker height.
fill_tiles:
	; Stored rows: # = bit 1, . = bit 0 (before writing-mode logic).
	; Tile 0: solid.
	db	11111111b                       ; ########
	db	11111111b                       ; ########
	db	11111111b                       ; ########
	db	11111111b                       ; ########
	db	11111111b                       ; ########
	db	11111111b                       ; ########
