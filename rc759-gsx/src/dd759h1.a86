	cmp	ax,6
	jb	op24_value_ready
	mov	ax,0
op24_value_ready:
	inc	ax
	mov	v_fill_index,ax
	les	di,0Eh[bp]                      ; ES:DI -> intout[] (GSX stack frame +14)
	mov	es:word ptr [di],ax
	ret

op25_SET_FILL_COLOR:                            ; CS:0CB8h
	mov	es:8[di],word ptr 1             ; contrl[4]: output word count
	les	di,6[bp]                        ; ES:DI -> intin[] (GSX stack frame +6)
	mov	ax,es:[di]
	call	sub_CD1h
	les	di,0Eh[bp]                      ; ES:DI -> intout[] (GSX stack frame +14)
	mov	v_fill_color,ax
	mov	es:word ptr [di],ax
	ret

sub_CD1h:                                       ; CS:0CD1h
	cmp	ax,2
	jb	sub_CD1_done
	mov	ax,1
sub_CD1_done:
	ret

op26_INQUIRE_COLOR_REP:                         ; CS:0CDAh
	mov	es:8[di],word ptr 4             ; contrl[4]: output word count
	les	di,6[bp]                        ; ES:DI -> intin[] (GSX stack frame +6)
	mov	cx,3
	mov	ax,es:[di]
	cmp	ax,2
	jb	op26_index_ready
	mov	ax,1
op26_index_ready:
	mov	bx,es:2[di]
	les	di,0Eh[bp]                      ; ES:DI -> intout[] (GSX stack frame +14)
	stosw
	xchg	ax,bx
	cmp	ax,0
	je	op26_standard_color
	mov	dl,byte ptr palette_realized[bx]
	mov	dh,4
op26_component_loop:
	xor	ax,ax
	test	dl,dh
	je	op26_component_ready
	mov	ax,01F4h
	test	dl,8
	je	op26_component_ready
	shl	ax,1
op26_component_ready:
	stosw
	shl	dh,1
	loop	op26_component_loop
	ret

op26_standard_color:
	mov	al,6
	mul	bl
	mov	si,offset palette_requested
	add	si,ax
	rep	movsw
	ret

op27_INQUIRE_CELL_ARRAY:                        ; CS:0D27h
	ret

op28_LOCATOR:                                   ; CS:0D28h
	les	di,0Ah[bp]                      ; ES:DI -> ptsin[] (GSX stack frame +10)
	mov	ax,es:[di]
	mov	v_draw_x,ax
	mov	ax,es:2[di]
	mov	v_draw_y,ax
	call	sub_FDEh
	cmp	byte ptr v_cursor_mode,1
	jne	op28_alternate_mode
op28_cursor_refresh:
	call	sub_26Dh
op28_wait_loop:
	xor	dx,dx
	mov	cx,8Dh
	int	0E0h
	call	get_loc_key
	or	al,al
	je	op28_wait_loop
	cmp	al,1
	je	op28_event_ready
	push	bx
	push	cx
	call	sub_26Dh
	pop	cx
	pop	bx
	call	clamp_locator
	jmps	op28_cursor_refresh
op28_event_ready:
	push	ax
	call	sub_26Dh
	pop	ax
	mov	bx,1
op28_return_one:
	mov	cx,1
op28_return_data:
	les	di,0Eh[bp]                      ; ES:DI -> intout[] (GSX stack frame +14)
	mov	al,ah
	xor	ah,ah
	mov	es:word ptr [di],ax
	les	di,12h[bp]                      ; ES:DI -> ptsout[] (GSX stack frame +18)
	mov	ax,v_draw_x
	mov	es:word ptr [di],ax
	mov	ax,v_draw_y
	mov	es:2[di],ax
	les	di,2[bp]                        ; ES:DI -> contrl[] (GSX stack frame +2)
	mov	es:4[di],cx                     ; contrl[2]: output coordinate-pair count
	mov	es:8[di],bx                     ; contrl[4]: output word count
	ret

op28_alternate_mode:
	call	get_loc_key
	or	al,al
	je	op28_no_event
	cmp	al,2
	je	op28_mode_key
	mov	bx,1
	jmps	op28_return_zero
op28_mode_key:
	push	ax
	call	clamp_locator
	pop	ax
	xor	bx,bx
	jmps	op28_return_one
op28_no_event:
	xor	bx,bx
op28_return_zero:
	xor	cx,cx
	jmps	op28_return_data
get_loc_key:
	call	sub_FB8h
	or	al,al
	je	sub_DB3_empty
	xchg	ah,al
	mov	al,2
	mov	si,0
	cmp	ah,0C8h
	je	sub_DB3_decode
	mov	si,8
	cmp	ah,0D0h
	je	sub_DB3_decode
	mov	si,10h
	cmp	ah,0CDh
	je	sub_DB3_decode
	mov	si,18h
	cmp	ah,0CBh
	je	sub_DB3_decode
	cmp	ah,0C9h
	je	sub_DB3_toggle
	mov	al,1
	ret

sub_DB3_toggle:
	xor	word ptr locator_step_offset,4
sub_DB3_empty:
	xor	ax,ax
	ret

sub_DB3_decode:
	add	si,locator_step_offset
	mov	bx,word ptr loc_tbl[si]
	inc	si
	inc	si
	mov	cx,word ptr loc_tbl[si]
	add	bx,v_draw_x
	add	cx,v_draw_y
	xor	ah,ah
	ret

clamp_locator:
	mov	v_draw_x,bx
	mov	v_draw_y,cx
	mov	ax,022Fh
	cmp	v_draw_x,ax
	jle	sub_E08_x_max_ready
	mov	v_draw_x,ax
sub_E08_x_max_ready:
	cmp	word ptr v_draw_x,0
	jge	sub_E08_x_min_ready
	mov	word ptr v_draw_x,0
sub_E08_x_min_ready:
	mov	ax,0FFh
	cmp	v_draw_y,ax
	jle	sub_E08_y_max_ready
	mov	v_draw_y,ax
sub_E08_y_max_ready:
	cmp	word ptr v_draw_y,0
	jge	sub_E08_y_min_ready
	mov	word ptr v_draw_y,0
sub_E08_y_min_ready:
	xor	ax,ax
	or	ax,ax
	ret

op29_VALUATOR:                                  ; CS:0E47h
	les	di,6[bp]                        ; ES:DI -> intin[] (GSX stack frame +6)
	mov	cx,es:2[di]
	cmp	byte ptr v_input_mode,1
	jne	op29_alternate_mode
op29_read_loop:
	push	cx
	call	sub_FB0h
	pop	cx
	call	sub_E87h
	je	op29_read_loop
	mov	bx,1
op29_return:
	les	di,0Eh[bp]                      ; ES:DI -> intout[] (GSX stack frame +14)
	mov	es:word ptr [di],cx
	les	di,2[bp]                        ; ES:DI -> contrl[] (GSX stack frame +2)
	mov	es:8[di],bx                     ; contrl[4]: output word count
	ret

op29_alternate_mode:
	call	sub_FB8h
	mov	bx,0
	or	al,al
	je	op29_return
	call	sub_E87h
	mov	bx,1
	je	op29_return
	mov	bx,0
	jmps	op29_return
sub_E87h:
	cmp	al,2Bh
	jne	sub_E87_not_plus
	inc	cx
	jmps	sub_E87_done
sub_E87_not_plus:
	cmp	al,2Dh
	jne	sub_E87_other
	dec	cx
	xor	ax,ax
sub_E87_other:
	or	ax,ax
sub_E87_done:
	ret

op30_CHOICE:                                    ; CS:0E98h
	call	sub_FDEh
	mov	es:8[di],word ptr 0             ; contrl[4]: output word count
	cmp	byte ptr v_key_mode,1
	je	op30_secondary_input
	call	sub_FB8h
	or	al,al
	je	op30_return
	mov	bx,1
	jns	op30_return
	sub	al,0BAh
	cbw
	mov	cx,ax
	cmp	ax,1
	jb	op30_invalid_key
	cmp	ax,0Ch
	jbe	op30_report
op30_invalid_key:
	mov	cx,0
op30_report:
	les	di,2[bp]                        ; ES:DI -> contrl[] (GSX stack frame +2)
	mov	es:8[di],bx                     ; contrl[4]: output word count
	les	di,0Eh[bp]                      ; ES:DI -> intout[] (GSX stack frame +14)
	mov	es:word ptr [di],cx
op30_return:
	ret

op30_secondary_input:
	call	sub_FB0h
	or	al,al
	jns	op30_secondary_empty
	mov	bx,1
	sub	al,0BAh
	cbw
	mov	cx,ax
	cmp	ax,1
	jb	op30_secondary_empty
	cmp	ax,0Ch
	jbe	op30_report
op30_secondary_empty:
	mov	cx,0
	mov	bx,0
	jmps	op30_report

op31_STRING:                                    ; CS:0EF5h
	les	di,6[bp]                        ; ES:DI -> intin[] (GSX stack frame +6)
	mov	cx,es:2[di]
	mov	ax,es:4[di]
	les	di,0Eh[bp]                      ; ES:DI -> intout[] (GSX stack frame +14)
	xor	bx,bx
	or	ax,ax
	je	op31_default_input
op31_mode_dispatch:
	cmp	byte ptr v_keyboard_mode,1
	je	op31_keyboard_input
op31_console_input:
	call	sub_FB8h
	or	al,al
	je	op31_done
	xor	ah,ah
	stosw
	inc	bx
	call	sub_FCCh
	loop	op31_console_input
	jmps	op31_done
op31_keyboard_input:
	call	sub_FC9h
	cmp	al,0Dh
	je	op31_done
	xor	ah,ah
	stosw
	inc	bx
	loop	op31_mode_dispatch
	jmps	op31_done
op31_default_input:
	cmp	byte ptr v_keyboard_mode,1
	je	op31_default_keyboard
op31_default_console:
	call	sub_FB8h
	or	al,al
	je	op31_done
	xor	ah,ah
	stosw
	inc	bx
	loop	op31_default_console
	jmps	op31_done
op31_default_keyboard:
	call	sub_FB0h
	cmp	al,0Dh
	je	op31_done
	xor	ah,ah
	stosw
	inc	bx
	loop	op31_default_keyboard
op31_done:
	les	di,2[bp]                        ; ES:DI -> contrl[] (GSX stack frame +2)
	mov	es:8[di],bx                     ; contrl[4]: output word count
	ret

op32_SET_WRITING_MODE:                          ; CS:0F5Ch
	mov	es:8[di],word ptr 1             ; contrl[4]: output word count
	les	di,6[bp]                        ; ES:DI -> intin[] (GSX stack frame +6)
	mov	bx,es:[di]
	mov	ax,1
	cmp	bx,0
	je	op32_value_ready
	cmp	bx,4
	ja	op32_value_ready
	mov	ax,bx
op32_value_ready:
	les	di,0Eh[bp]                      ; ES:DI -> intout[] (GSX stack frame +14)
	mov	writing_mode,ax
	mov	es:word ptr [di],ax
	ret

op33_SET_INPUT_MODE:                            ; CS:0F81h
	mov	es:8[di],word ptr 1             ; contrl[4]: output word count
	les	di,6[bp]                        ; ES:DI -> intin[] (GSX stack frame +6)
	mov	bx,es:[di]
	mov	ax,es:2[di]
	cmp	ax,2
	je	op33_mode_ready
	mov	ax,1
op33_mode_ready:
	mov	si,offset v_device_input_mode
	cmp	bx,4
	jbe	op33_index_ready
	mov	bx,0
op33_index_ready:
	add	si,bx
	mov	[si],al
	les	di,0Eh[bp]                      ; ES:DI -> intout[] (GSX stack frame +14)
	mov	es:word ptr [di],ax
	ret

op34_INQUIRE_INPUT_MODE:                        ; CS:0FAFh
	ret

sub_FB0h:
	call	sub_FB8h
	or	al,al
	je	sub_FB0h
	ret

sub_FB8h:
	push	es
	push	di
	push	dx
	push	cx
	push	bx
	mov	dl,0FFh
	mov	cl,6
	int	0E0h
	pop	bx
	pop	cx
	pop	dx
	pop	di
	pop	es
	ret

sub_FC9h:
	call	sub_FB0h
sub_FCCh:                                       ; CS:0FCCh
	push	ax
	push	es
	push	di
	push	cx
	push	bx
	mov	dl,al
	mov	cx,6
	int	0E0h
	pop	bx
	pop	cx
	pop	di
	pop	es
	pop	ax

op00_invalid:                                   ; CS:0FDDh
	ret

sub_FDEh:
	mov	al,1Bh
	call	sub_FCCh
	mov	al,36h
	jmp	sub_FCCh

sub_FE8h:                                       ; CS:0FE8h
	mov	al,1Bh
	call	sub_FCCh
	mov	al,37h
	jmp	sub_FCCh

get_gcb_mutex:                                  ; CS:0FF2h
	mov	al,0FFh
	xchg	byte ptr gcb_mx,al
	test	al,al
	je	sub_FF2_done
sub_FF2_wait:
	push	di
	push	bp
	push	es
	mov	cl,8Dh
	mov	dx,1
	int	0E0h
	pop	es
	pop	bp
	pop	di
	jmps	get_gcb_mutex
sub_FF2_done:
	ret

free_gcb_mutex:                                 ; CS:0100Ch
	mov	byte ptr gcb_mx,0
	ret

init_graphics:                                  ; CS:01012h
	; Keep both segment operands relocatable; their linked bytes are zero.
	mov	word ptr gcb_seg,SEG extra_segment_anchor
	mov	al,0
	mov	ah,1
	mov	dx,SEG gcb_seg
	mov	cx,offset gcb_mx
	int	028h
	mov	word ptr v_gfx_init,1
	ret

exit_graphics:                                  ; CS:0102Bh
	mov	al,1
	int	028h
	mov	word ptr v_gfx_init,0
	ret

	rb	10                              ; CODE trailing padding

; ============================================================================
; DATA SEGMENT
; All variables declared here so CODE can reference them by name+type.
; Initialized bytes are recovered from and checked against the original SYS.
; ============================================================================
	dseg


	rb	100h                            ; DATA:0000..00FF (runtime state — task 6)

; Jump table at DATA:0100 — 35 near CODE pointers.
; Values verified against disasm/dd759h1.a86.
jump_table:
	dw	offset op00_invalid             ; op  0 op00_invalid
	dw	offset op01_OPEN_WORKSTATION    ; op  1 op01_OPEN_WORKSTATION
	dw	offset op02_CLOSE_WORKSTATION   ; op  2 op02_CLOSE_WORKSTATION
	dw	offset op03_CLEAR_WORKSTATION   ; op  3 op03_CLEAR_WORKSTATION
	dw	offset op04_UPDATE_WORKSTATION  ; op  4 op04_UPDATE_WORKSTATION
	dw	offset op05_ESCAPE              ; op  5 op05_ESCAPE
	dw	offset op06_POLYLINE            ; op  6 op06_POLYLINE
	dw	offset op07_POLYMARKER          ; op  7 op07_POLYMARKER
	dw	offset op08_TEXT                ; op  8 op08_TEXT
	dw	offset op09_FILLED_AREA         ; op  9 op09_FILLED_AREA
	dw	offset op10_CELL_ARRAY          ; op 10 op10_CELL_ARRAY
	dw	offset op11_GDP                 ; op 11 op11_GDP
	dw	offset op12_SET_CHAR_HEIGHT     ; op 12 op12_SET_CHAR_HEIGHT
	dw	offset op13_SET_CHAR_UP_VECTOR  ; op 13 op13_SET_CHAR_UP_VECTOR
	dw	offset op14_SET_COLOR_REP       ; op 14 op14_SET_COLOR_REP
	dw	offset op15_SET_LINETYPE        ; op 15 op15_SET_LINETYPE
	dw	offset op16_SET_LINE_WIDTH      ; op 16 op16_SET_LINE_WIDTH
	dw	offset op17_SET_LINE_COLOR      ; op 17 op17_SET_LINE_COLOR
	dw	offset op18_SET_MARKER_TYPE     ; op 18 op18_SET_MARKER_TYPE
	dw	offset op19_SET_MARKER_SCALE    ; op 19 op19_SET_MARKER_SCALE
	dw	offset op20_SET_MARKER_COLOR    ; op 20 op20_SET_MARKER_COLOR
	dw	offset op21_SET_TEXT_FONT       ; op 21 op21_SET_TEXT_FONT
	dw	offset op22_SET_TEXT_COLOR      ; op 22 op22_SET_TEXT_COLOR
	dw	offset op23_SET_FILL_STYLE      ; op 23 op23_SET_FILL_STYLE
	dw	offset op24_SET_FILL_INDEX      ; op 24 op24_SET_FILL_INDEX
	dw	offset op25_SET_FILL_COLOR      ; op 25 op25_SET_FILL_COLOR
	dw	offset op26_INQUIRE_COLOR_REP   ; op 26 op26_INQUIRE_COLOR_REP
	dw	offset op27_INQUIRE_CELL_ARRAY  ; op 27 op27_INQUIRE_CELL_ARRAY
	dw	offset op28_LOCATOR             ; op 28 op28_LOCATOR
	dw	offset op29_VALUATOR            ; op 29 op29_VALUATOR
	dw	offset op30_CHOICE              ; op 30 op30_CHOICE
	dw	offset op31_STRING              ; op 31 op31_STRING
	dw	offset op32_SET_WRITING_MODE    ; op 32 op32_SET_WRITING_MODE
	dw	offset op33_SET_INPUT_MODE      ; op 33 op33_SET_INPUT_MODE
	dw	offset op34_INQUIRE_INPUT_MODE  ; op 34 op34_INQUIRE_INPUT_MODE

; Secondary escape sub-function dispatch table at DATA:0146
; 20 entries (sub-functions 0..19).
esc_table:
	dw	offset escfn0                   ; escfn0 identification
	dw	offset escfn1                   ; escfn1 character cells
	dw	offset escfn2                   ; escfn2 enter graphics
	dw	offset escfn3                   ; escfn3 exit graphics
	dw	offset escfn4                   ; escfn4 cursor up
	dw	offset escfn5                   ; escfn5 cursor down
	dw	offset escfn6                   ; escfn6 cursor right
	dw	offset escfn7                   ; escfn7 cursor left
	dw	offset escfn8                   ; escfn8 home cursor
	dw	offset escfn9                   ; escfn9 erase screen remainder
	dw	offset escf10                   ; escf10 erase line remainder
	dw	offset escf11                   ; escf11 cursor address
	dw	offset escf12                   ; escf12 alpha text
	dw	offset escf13                   ; escf13 reverse on
	dw	offset escf14                   ; escf14 reverse off
	dw	offset escf15                   ; escf15 cursor inquiry
	dw	offset escf16                   ; escf16 input-device status
	dw	offset escf17                   ; escf17 hardcopy stub
	dw	offset escf18                   ; escf18 place graphic cursor
	dw	offset escf19                   ; escf19 remove graphic cursor

; GDP sub-function dispatch table at DATA:016E.
gdp_table:
	dw	offset op00_invalid
	dw	offset gdpbar
	dw	offset gdp02_stub
	dw	offset gdp03_stub
	dw	offset gdp04_stub
	dw	offset gdp05_stub
	dw	offset op00_invalid
	dw	offset op00_invalid

; Typed variable declarations — addresses from disasm analysis
v_wks_id	dw	0                       ; DATA:017E intin[1] workstation id
v_linetype	dw	0                       ; DATA:0180 current linetype (1-7)
v_line_color	dw	0                       ; DATA:0182 polyline color index
v_marker_type	dw	0                       ; DATA:0184 marker type (1-5)
v_marker_color	dw	0                       ; DATA:0186 polymarker color
v_text_font	dw	0                       ; DATA:0188 text font (1)
v_text_color	dw	0                       ; DATA:018A text color
v_fill_style	dw	0                       ; DATA:018C fill interior style (0-3)
v_fill_index	dw	0                       ; DATA:018E fill style index
v_fill_color	dw	0                       ; DATA:0190 fill color

	rb	8
v_cell_width	dw	0                       ; DATA:019A cell width
v_cell_height	dw	0                       ; DATA:019C cell height
v_cell_columns	dw	0                       ; DATA:019E number of columns
v_cell_row_stride	dw	0               ; DATA:01A0 cell data row stride
v_cell_x_start	dw	0                       ; DATA:01A2 cell x start
v_cell_color	dw	0                       ; DATA:01A4 cell color

v_x1		dw	0                       ; DATA:01A6 current draw x1
v_x2		dw	0                       ; DATA:01A8 current draw x2
v_y1		dw	0                       ; DATA:01AA current draw y1
v_y2		dw	0                       ; DATA:01AC current draw y2

v_line_step	dw	0                       ; DATA:01AE X/Y step for pixel addressing
v_delta_major	dw	0                       ; DATA:01B0 Bresenham major-axis delta
v_line_error	dw	0                       ; DATA:01B2 Bresenham error accumulator

v_polyline_state dw	0                       ; DATA:01B4 single-point polyline marker
pixel_mode	db	0                       ; DATA:01B6 active pixel writing mode

writing_mode	dw	0                       ; DATA:01B7 GSX writing mode (1-4)

pixel_lut	dw	0                       ; DATA:01B9 pixel truth-table pointer

	rb	4
draw_pattern	dw	0                       ; DATA:01BF rotating line/fill bit pattern

; POLYLINE indexes this base with 2*line_type; valid types are 1..7.
line_type_base:
	dw	1111111111111111b               ; Original slot 0, before valid types.
line_types:
	dw	1111111111111111b               ; 1 ################
	dw	0000000001111111b               ; 2 .........#######
	dw	0001110000011100b               ; 3 ...###.....###..
	dw	0001110001111111b               ; 4 ...###...#######
	dw	0000111111111111b               ; 5 ....############
	dw	0011001100110011b               ; 6 ..##..##..##..##
	dw	0101010101010101b               ; 7 .#.#.#.#.#.#.#.#

; One pixel bit per word: index X & 15, MSB first.
bit_masks:
	dw	1000000000000000b
	dw	0100000000000000b
	dw	0010000000000000b
	dw	0001000000000000b
	dw	0000100000000000b
	dw	0000010000000000b
	dw	0000001000000000b
	dw	0000000100000000b
	dw	0000000010000000b
	dw	0000000001000000b
	dw	0000000000100000b
	dw	0000000000010000b
	dw	0000000000001000b
	dw	0000000000000100b
	dw	0000000000000010b
	dw	0000000000000001b

; load_pixel_lut selects four-byte tables; plot_pixel indexes each
; with 2*pattern_bit + old_pixel. Entries are output bits (00h/FFh).
pixel_truth_tables:
	db	00h,0FFh,00h,0FFh               ; Table 0
	db	00h,0FFh,0FFh,00h               ; Table 1
	db	00h,0FFh,00h,0FFh               ; Table 2
	db	00h,0FFh,0FFh,00h               ; Table 3
	db	00h,00h,00h,00h                 ; Table 4
	db	00h,00h,0FFh,00h                ; Table 5
	db	00h,00h,00h,00h                 ; Table 6
	db	00h,00h,0FFh,0FFh               ; Table 7
	db	00h,00h,00h,00h                 ; Table 8
	db	00h,00h,00h,0FFh                ; Table 9

; OPEN_WORKSTATION copies these 14 bytes into palette_requested.
palette_defaults:
	dw	0,0,0                           ; Color 0: black RGB, range 0..1000.
	dw	1000,1000,1000                  ; Color 1: white RGB.
	db	00h,07h                         ; Packed color control bytes.
palette_requested:
	dw	0,0,0                           ; Requested color 0 RGB.
	dw	0,0,0                           ; Requested color 1 RGB.
palette_realized:
	db	00h,00h                         ; Packed realized colors.
pixel_color_control:
	db	00h,01h                         ; Per-color input to load_pixel_lut.

; Preserve the original count: escfn0 copies 42 WORDS, although the
; text has 21 characters. The copy includes following escape data.
driver_identification:
	dw	42
	dw	'1','.','1',' ','R','C','7','5','0',' ','B','/','W'
	dw	'1','1','/','1','3','/','8','4'

; Console sequences: word count followed by one word per character.
seq_cursor_up:
	dw	2,01Bh,'A'
seq_cursor_down:
	dw	2,01Bh,'B'
seq_cursor_right:
	dw	2,01Bh,'C'
seq_cursor_left:
	dw	2,01Bh,'D'
seq_cursor_home:
	dw	2,01Bh,'H'
seq_erase_screen:
	dw	2,01Bh,'J'
seq_erase_line:
	dw	2,01Bh,'K'
seq_reverse_on:
	dw	2,01Bh,'p'
seq_reverse_off:
	dw	2,01Bh,'q'
seq_cursor_address:
	dw	4,01Bh,'Y'                      ; Final two words updated by escf11.
v_cursor_x	dw	020h                    ; DATA:029F cursor coordinate (escape 11)
v_cursor_y	dw	020h                    ; DATA:02A1 cursor y

