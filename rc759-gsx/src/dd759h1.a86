v_cell_columns	dw	0                       ; DATA:414 number of columns
v_cell_row_stride	dw	0               ; DATA:416 cell data row stride
v_cell_x_start	dw	0                       ; DATA:418 cell x start
v_cell_color	dw	0                       ; DATA:420 cell color

v_x1		dw	0                       ; DATA:422 current draw x1
v_x2		dw	0                       ; DATA:424 current draw x2
v_y1		dw	0                       ; DATA:426 current draw y1
v_y2		dw	0                       ; DATA:428 current draw y2

v_line_step	dw	0                       ; DATA:430 X/Y step for pixel addressing
v_delta_major	dw	0                       ; DATA:432 Bresenham major-axis delta
v_line_error	dw	0                       ; DATA:434 Bresenham error accumulator

v_polyline_state dw	0                       ; DATA:436 single-point polyline marker
pixel_mode	db	0                       ; DATA:438 active pixel writing mode

writing_mode	dw	0                       ; DATA:439 GSX writing mode (1-4)

pixel_lut	dw	0                       ; DATA:441 pixel truth-table pointer

	rb	4
draw_pattern	dw	0                       ; DATA:447 rotating line/fill bit pattern

; POLYLINE indexes this base with 2*line_type; valid types are 1..7.
line_type_base:
	dw	1111111111111111b               ; Original slot 0, before valid types.
line_types:
	dw	1111111111111111b               ; 1 ################
	dw	0000000001111111b               ; 2 .........#######
	dw	0001110000011100b               ; 3 ...###.....###..
	dw	0001110001111111b               ; 4 ...###...#######
	dw	0000111111111111b               ; 5 ....############
	dw	0011001100110011b               ; 6 ..##..##..##..##
	dw	0101010101010101b               ; 7 .#.#.#.#.#.#.#.#

; One pixel bit per word: index X & 15, MSB first.
bit_masks:
	dw	1000000000000000b
	dw	0100000000000000b
	dw	0010000000000000b
	dw	0001000000000000b
	dw	0000100000000000b
	dw	0000010000000000b
	dw	0000001000000000b
	dw	0000000100000000b
	dw	0000000010000000b
	dw	0000000001000000b
	dw	0000000000100000b
	dw	0000000000010000b
	dw	0000000000001000b
	dw	0000000000000100b
	dw	0000000000000010b
	dw	0000000000000001b

; load_pixel_lut selects four-byte tables; plot_pixel indexes each
; with 2*pattern_bit + old_pixel. Entries control XOR toggles (0/255).
; new_pixel = old_pixel XOR (entry != 0): 0 keeps, 255 flips.
; Example: replace/color 1 uses table 3; pattern=1, old=0 flips to 1.
pixel_truth_tables:
	db	00h,0FFh,00h,0FFh               ; Table 0
	db	00h,0FFh,0FFh,00h               ; Table 1
	db	00h,0FFh,00h,0FFh               ; Table 2
	db	00h,0FFh,0FFh,00h               ; Table 3
	db	00h,00h,00h,00h                 ; Table 4
	db	00h,00h,0FFh,00h                ; Table 5
	db	00h,00h,00h,00h                 ; Table 6
	db	00h,00h,0FFh,0FFh               ; Table 7
	db	00h,00h,00h,00h                 ; Table 8
	db	00h,00h,00h,0FFh                ; Table 9

; OPEN_WORKSTATION copies these 14 bytes into palette_requested.
palette_defaults:
	dw	0,0,0                           ; Color 0: black RGB, range 0..1000.
	dw	1000,1000,1000                  ; Color 1: white RGB.
	db	00h,07h                         ; Packed color control bytes.
palette_requested:
	dw	0,0,0                           ; Requested color 0 RGB.
	dw	0,0,0                           ; Requested color 1 RGB.
palette_realized:
	db	00h,00h                         ; Packed realized colors.
pixel_color_control:
	db	00h,01h                         ; Per-color input to load_pixel_lut.

; Preserve the original count: escfn0 copies 42 WORDS, although the
; text has 21 characters. The copy includes following escape data.
driver_identification:
	dw	42
	dw	'1','.','1',' ','R','C','7','5','0',' ','B','/','W'
	dw	'1','1','/','1','3','/','8','4'

; Console sequences: word count followed by one word per character.
seq_cursor_up:
	dw	2,01Bh,'A'
seq_cursor_down:
	dw	2,01Bh,'B'
seq_cursor_right:
	dw	2,01Bh,'C'
seq_cursor_left:
	dw	2,01Bh,'D'
seq_cursor_home:
	dw	2,01Bh,'H'
seq_erase_screen:
	dw	2,01Bh,'J'
seq_erase_line:
	dw	2,01Bh,'K'
seq_reverse_on:
	dw	2,01Bh,'p'
seq_reverse_off:
	dw	2,01Bh,'q'
seq_cursor_address:
	dw	4,01Bh,'Y'                      ; Final two words updated by escf11.
v_cursor_x	dw	020h                    ; DATA:671 cursor coordinate (escape 11)
v_cursor_y	dw	020h                    ; DATA:673 cursor y

v_line_width	dw	1                       ; DATA:675 line width
v_marker_scale	dw	1                       ; DATA:677 marker scale

v_saved_x	dw	0                       ; DATA:679 saved cursor x
v_saved_y	dw	0                       ; DATA:681 saved cursor y
v_device_input_mode	db	0               ; DATA:683 mode selector 0
v_cursor_mode	db	0                       ; DATA:684 cursor mode
v_input_mode	db	0                       ; DATA:685 input mode
v_key_mode	db	0                       ; DATA:686 keyboard mode
v_keyboard_mode	db	0                       ; DATA:687 keyboard mode selector

; Keyboard-controlled graphics locator, not the alpha text cursor.
; Key code 201 toggles offset 0/4: steps of 1/10 pixels respectively.
; The physical RC759 key corresponding to code 201 is not established.
locator_step_offset	dw	0               ; DATA:688 starts with small steps
loc_tbl:
	dw	0,1,0,10                        ; Key 200: small/large positive Y.
	dw	0,-1,0,-10                      ; Key 208: small/large negative Y.
	dw	1,0,10,0                        ; Key 205: small/large positive X.
	dw	-1,0,-10,0                      ; Key 203: small/large negative X.

	; Following bytes resemble additional diagonal delta pairs, but
	; get_loc_key only selects the four directions above. Role unknown.
	db	001h,000h,0FFh,0FFh,00Ah,000h,0F6h,0FFh,001h,000h,001h,000h,00Ah,000h,00Ah,000h
	db	0FFh,0FFh,001h,000h,0F6h,0FFh,00Ah,000h,0FFh,0FFh,0FFh,0FFh,0F6h,0FFh,0F6h,0FFh
	db	0E8h,003h,0E8h,003h,001h,000h,001h,000h,000h,000h

v_fill_min_y	dw	0                       ; DATA:764
	rb	2
v_fill_max_y	dw	0                       ; DATA:768

	rb	4
v_text_point_count	dw	0               ; DATA:774 decoded glyph point count
v_fill_intersection_count	dw	0       ; DATA:776
	rb	2
v_fill_pattern_count	dw	0               ; DATA:780
v_fill_npts	dw	0                       ; DATA:782
v_fill_npoints_minus1	dw	0               ; DATA:784
v_fill_scan_y	dw	0                       ; DATA:786
v_fill_pattern_offset	dw	0               ; DATA:788

v_text_points	db	0                       ; DATA:790 decoded glyph point buffer

	rb	199
text_sine	dw	0                       ; DATA:990 text sine, scaled by 2048
text_cosine	dw	0                       ; DATA:992 text cosine, scaled by 2048
text_scale	dw	0                       ; DATA:994 text scale
marker_sine	dw	0                       ; DATA:996 marker sine, scaled by 2048
marker_cosine	dw	0                       ; DATA:998 marker cosine, scaled by 2048
marker_scale	dw	0                       ; DATA:1000 marker scale
transform_sine	dw	0                       ; DATA:1002 polymarker scratch
transform_cosine	dw	0               ; DATA:1004 polymarker scratch
transform_scale	dw	0                       ; DATA:1006 polymarker scratch

v_text_dx	dw	0                       ; DATA:1008 text x advance
v_text_dy	dw	0                       ; DATA:1010 text y advance

v_draw_x	dw	0                       ; DATA:1012 current drawing x
v_draw_y	dw	0                       ; DATA:1014 current drawing y

v_text_x	dw	0                       ; DATA:1016 text origin x
v_text_y	dw	0                       ; DATA:1018 text origin y

	include sine.a86

; OPEN_WORKSTATION intout, one-based indices per GSX/DRI skeleton.
; Advertised capabilities, not proof that every operation works.
DEV_TAB:
	dw	559                             ; 1 Maximum X coordinate (560 pixels, origin 0).
	dw	255                             ; 2 Maximum Y coordinate (256 pixels, origin 0).
	dw	1                               ; 3 Coordinate precision: 0 exact, 1 not exact.
	dw	392                             ; 4 Pixel width in micrometers.
	dw	578                             ; 5 Pixel height in micrometers.
	dw	232                             ; 6 Number of character heights.
	dw	7                               ; 7 Number of line styles.
	dw	1                               ; 8 Number of line widths.
	dw	5                               ; 9 Number of marker types.
	dw	232                             ; 10 Number of marker sizes.
	dw	1                               ; 11 Number of text fonts.
	dw	6                               ; 12 Number of area patterns.
	dw	6                               ; 13 Number of crosshatch patterns.
	dw	2                               ; 14 Number of simultaneous colors.
	dw	1                               ; 15 Number of supported GDPs.
	dw	1                               ; 16 GDP slot 1: function 1, filled rectangle (bar).
	dw	-1                              ; 17 GDP slot 2: unused.
	dw	-1                              ; 18 GDP slot 3: unused.
	dw	-1                              ; 19 GDP slot 4: unused.
	dw	-1                              ; 20 GDP slot 5: unused.
	dw	-1                              ; 21 GDP slot 6: unused.
	dw	-1                              ; 22 GDP slot 7: unused.
	dw	-1                              ; 23 GDP slot 8: unused.
	dw	-1                              ; 24 GDP slot 9: unused.
	dw	-1                              ; 25 GDP slot 10: unused.
	dw	3                               ; 26 GDP slot 1 attribute class: fill area.
	dw	-1                              ; 27 GDP slot 2 attribute class: unused.
	dw	-1                              ; 28 GDP slot 3 attribute class: unused.
	dw	-1                              ; 29 GDP slot 4 attribute class: unused.
	dw	-1                              ; 30 GDP slot 5 attribute class: unused.
	dw	-1                              ; 31 GDP slot 6 attribute class: unused.
	dw	-1                              ; 32 GDP slot 7 attribute class: unused.
	dw	-1                              ; 33 GDP slot 8 attribute class: unused.
	dw	-1                              ; 34 GDP slot 9 attribute class: unused.
	dw	-1                              ; 35 GDP slot 10 attribute class: unused.
	dw	1                               ; 36 Color capability.
	dw	1                               ; 37 Text rotation supported.
	dw	1                               ; 38 Polygon fill supported.
	dw	0                               ; 39 Cell-array inquiry not supported.
	dw	4                               ; 40 Palette entries, not bitmap planes.
	dw	1                               ; 41 Number of locator input devices.
	dw	1                               ; 42 Number of valuator input devices.
	dw	1                               ; 43 Number of choice input devices.
	dw	1                               ; 44 Number of string input devices.
	dw	2                               ; 45 Workstation type: input and output.

; OPEN_WORKSTATION ptsout: six coordinate pairs in device units.
; One-based word indices; zero components are not padding.
SIZ_TAB:
	dw	0                               ; 1 Minimum character size: X component.
	dw	7                               ; 2 Minimum character height.
	dw	0                               ; 3 Maximum character size: X component.
	dw	210                             ; 4 Maximum character height.
	dw	1                               ; 5 Minimum line width.
	dw	0                               ; 6 Minimum line size: Y component.
	dw	1                               ; 7 Maximum line width.
	dw	0                               ; 8 Maximum line size: Y component.
	dw	0                               ; 9 Minimum marker size: X component.
	dw	6                               ; 10 Minimum marker height.
	dw	0                               ; 11 Maximum marker size: X component.
	dw	180                             ; 12 Maximum marker height.
fill_tiles:
	; Stored rows: # = bit 1, . = bit 0 (before writing-mode logic).
	; Tile 0: solid.
	db	11111111b                       ; ########
	db	11111111b                       ; ########
	db	11111111b                       ; ########
	db	11111111b                       ; ########
	db	11111111b                       ; ########
	db	11111111b                       ; ########
	db	11111111b                       ; ########
	db	11111111b                       ; ########

	; Tile 1: hatch index 1.
	db	10001000b                       ; #...#...
	db	10001000b                       ; #...#...
	db	10001000b                       ; #...#...
	db	10001000b                       ; #...#...
	db	10001000b                       ; #...#...
	db	10001000b                       ; #...#...
	db	10001000b                       ; #...#...
	db	10001000b                       ; #...#...

	; Tile 2: hatch index 2.
	db	11111111b                       ; ########
	db	00000000b                       ; ........
	db	00000000b                       ; ........
	db	00000000b                       ; ........
	db	11111111b                       ; ########
	db	00000000b                       ; ........
	db	00000000b                       ; ........
	db	00000000b                       ; ........

	; Tile 3: hatch index 3.
	db	10001000b                       ; #...#...
	db	01000100b                       ; .#...#..
	db	00100010b                       ; ..#...#.
	db	00010001b                       ; ...#...#
	db	10001000b                       ; #...#...
	db	01000100b                       ; .#...#..
	db	00100010b                       ; ..#...#.
	db	00010001b                       ; ...#...#

	; Tile 4: hatch index 4.
	db	00010001b                       ; ...#...#
	db	00100010b                       ; ..#...#.
	db	01000100b                       ; .#...#..
	db	10001000b                       ; #...#...
	db	00010001b                       ; ...#...#
	db	00100010b                       ; ..#...#.
	db	01000100b                       ; .#...#..
	db	10001000b                       ; #...#...

	; Tile 5: hatch index 5.
	db	11111111b                       ; ########
	db	10001000b                       ; #...#...
	db	10001000b                       ; #...#...
	db	10001000b                       ; #...#...
	db	11111111b                       ; ########
	db	10001000b                       ; #...#...
	db	10001000b                       ; #...#...
	db	10001000b                       ; #...#...

	; Tile 6: hatch index 6.
	db	10000001b                       ; #......#
	db	01000010b                       ; .#....#.
	db	00100100b                       ; ..#..#..
	db	00011000b                       ; ...##...
	db	00011000b                       ; ...##...
	db	00100100b                       ; ..#..#..
	db	01000010b                       ; .#....#.
	db	10000001b                       ; #......#

	; Tile 7: pattern index 1.
	db	00000100b                       ; .....#..
	db	00000000b                       ; ........
	db	01000000b                       ; .#......
	db	00000000b                       ; ........
	db	00000100b                       ; .....#..
	db	00000000b                       ; ........
	db	01000000b                       ; .#......
	db	00000000b                       ; ........

	; Tile 8: pattern index 2.
	db	00000000b                       ; ........
	db	00100010b                       ; ..#...#.
	db	00000000b                       ; ........
	db	10001000b                       ; #...#...
	db	00000000b                       ; ........
	db	00100010b                       ; ..#...#.
	db	00000000b                       ; ........
	db	10001000b                       ; #...#...

	; Tile 9: pattern index 3.
	db	00000000b                       ; ........
	db	10101010b                       ; #.#.#.#.
	db	00000000b                       ; ........
	db	10101010b                       ; #.#.#.#.
	db	00000000b                       ; ........
	db	10101010b                       ; #.#.#.#.
	db	00000000b                       ; ........
	db	10101010b                       ; #.#.#.#.

	; Tile 10: pattern index 4.
	db	00010001b                       ; ...#...#
	db	10101010b                       ; #.#.#.#.
	db	01000100b                       ; .#...#..
	db	10101010b                       ; #.#.#.#.
	db	00010001b                       ; ...#...#
	db	10101010b                       ; #.#.#.#.
	db	01000100b                       ; .#...#..
	db	10101010b                       ; #.#.#.#.

	; Tile 11: pattern index 5.
	db	01010101b                       ; .#.#.#.#
	db	10101010b                       ; #.#.#.#.
	db	00010001b                       ; ...#...#
	db	10101010b                       ; #.#.#.#.
	db	01010101b                       ; .#.#.#.#
	db	10101010b                       ; #.#.#.#.
	db	00010001b                       ; ...#...#
	db	10101010b                       ; #.#.#.#.

	; Tile 12: pattern index 6.
	db	10101010b                       ; #.#.#.#.
	db	01010101b                       ; .#.#.#.#
	db	10101010b                       ; #.#.#.#.
	db	01010101b                       ; .#.#.#.#
	db	10101010b                       ; #.#.#.#.
	db	01010101b                       ; .#.#.#.#
	db	10101010b                       ; #.#.#.#.
	db	01010101b                       ; .#.#.#.#

gcb_mx	db	0                               ; DATA:1420 XIOS gcb_mx semaphore
		; This initial segment word is a LINK-86 fixup to EXTRA.
gcb_seg	dw	SEG extra_segment_anchor        ; DATA:1421 pixel memory segment
v_gfx_init	dw	0                       ; DATA:1423 init done (1 after first open)

	rb	513
	include glyphs.a86

; ============================================================================
; EXTRA SEGMENT
; ============================================================================
	eseg

extra_segment_anchor	rb	992

	end
