; RC759 GSX-86 graphics driver (H1 variant, high-resolution monochrome)
; Original: bin/dd759h1.sys  (8576 bytes)
; Toolchain: RASM-86 1.2 + LINK-86 1.4
; Build:
;   rasm86 dd759h1.a86
;   link86 dd759h1[DATA[ORIGIN[0],MAXIMUM[1000]],EXTRA[ADDITIONAL[200]]]

	public	driver_entry

; ============================================================================
; CODE SEGMENT
; ============================================================================
	cseg

; ----------------------------------------------------------------------------
; GIOS entry dispatcher  CS:0000
;
; Far-called by GDOS.  DS:DX -> parameter block:
;   PB+00  dd  far ptr contrl[]
;   PB+04  dd  far ptr intin[]
;   PB+08  dd  far ptr ptsin[]
;   PB+0C  dd  far ptr intout[]
;   PB+10  dd  far ptr ptsout[]
; PB+12h is the ptsout segment word, not the contrl array.
; Backward loads +12h..+00h push all five pointers in normal stack order.
; ----------------------------------------------------------------------------
driver_entry:
	mov	ax,sp
	mov	bx,ss
	mov	cx,SEG jump_table               ; fixup -> DATA segment
	mov	ss,cx
	mov	sp,offset glyph_offsets-1       ; Original stack top below glyph table.
	push	bx
	push	ax
	push	ds
	mov	si,dx                           ; DS:SI -> caller's five-pointer GSX PB.
	add	si,012h                         ; PB+18: ptsout pointer's segment word.
	mov	cx,00Ah
	std
copy_pb_loop:
	lodsw
	push	ax
	loop	copy_pb_loop
	push	bp
	mov	bp,sp
	mov	ax,SEG jump_table               ; fixup -> DATA segment
	mov	ds,ax
	cld
	les	di,2[bp]                        ; ES:DI -> contrl[] (GSX stack frame +2)
	mov	es:4[di],word ptr 0             ; contrl[2]: output coordinate-pair count
	mov	es:8[di],word ptr 0             ; contrl[4]: output word count
	mov	bx,es:[di]                      ; contrl[0]: function number
	cmp	bx,022h
	ja	dispatch_done
	shl	bx,1
	call	word ptr jump_table[bx]
dispatch_done:
	pop	bp
	add	sp,014h
	pop	ds
	pop	ax
	pop	bx
	mov	ss,bx
	mov	sp,ax
	retf

; ============================================================================
; OPEN WORKSTATION  CS:004E
; Sets contrl[2]=6 (nptsout), contrl[4]=45 (nintout).
; Copies intout[] defaults then ptsout[] defaults from DATA tables.
; Reads intin[] for workstation attributes, clamps to valid ranges,
; stores to attribute state variables.
; ============================================================================
op01_OPEN_WORKSTATION:
	mov	es:4[di],word ptr 6             ; contrl[2]: output coordinate-pair count
	mov	es:8[di],word ptr 02Dh          ; contrl[4]: output word count
	les	di,0Eh[bp]                      ; ES:DI -> intout[] (GSX stack frame +14)
	mov	si,offset DEV_TAB               ; DATA: intout defaults table
	mov	cx,02Dh                         ; 45 words
	rep movsw
	les	di,012h[bp]                     ; ES:DI -> ptsout[] (GSX stack frame +18)
	mov	si,offset SIZ_TAB               ; DATA: ptsout defaults table
	mov	cx,00Ch                         ; 12 words
	rep movsw
	mov	word ptr writing_mode,1         ; GSX writing mode = replace
	mov	ax,0
	call	sincos_degrees                  ; angle 0 -> CX=sin=0, DX=cos=2048
	mov	text_sine,cx                    ; text rotation sine
	mov	marker_sine,cx
	mov	text_cosine,dx                  ; text rotation cosine
	mov	marker_cosine,dx
	mov	ax,8
	shl	ax,1
	shl	ax,1                            ; ax = 32 = marker size default
	mov	text_scale,ax
	mov	marker_scale,ax
	mov	ax,1
	mov	v_line_width,ax                 ; default line width
	mov	v_marker_scale,ax               ; default marker scale
	les	di,6[bp]                        ; ES:DI -> intin[] (GSX stack frame +6)
	mov	ax,es:[di]                      ; intin[1] = workstation id (ignored)
	add	di,2
	mov	v_wks_id,ax                     ; store
	mov	ax,es:[di]                      ; intin[2] = linetype
	add	di,2
	cmp	ax,7
	jbe	ow_lt_ok
	mov	ax,1
ow_lt_ok:
	mov	v_linetype,ax
	mov	ax,es:[di]                      ; intin[3] = polyline color
	call	sub_CD1h
	mov	v_line_color,ax
	mov	ax,es:[di]                      ; intin[4] = marker type
	add	di,2
	cmp	ax,5
	jbe	ow_mt_ok
	mov	ax,5
ow_mt_ok:
	mov	v_marker_type,ax
	mov	ax,es:[di]                      ; intin[5] = polymarker color
	add	di,2
	call	sub_CD1h
	mov	v_marker_color,ax
	mov	ax,es:[di]                      ; intin[6] = text font
	add	di,2
	cmp	ax,1
	jbe	ow_tf_ok
	mov	ax,1
ow_tf_ok:
	mov	v_text_font,ax
	mov	ax,es:[di]                      ; intin[7] = text color
	add	di,2
	call	sub_CD1h
	mov	v_text_color,ax
	mov	ax,es:[di]                      ; intin[8] = fill interior style
	cmp	ax,3
	jbe	ow_fi_ok
	mov	ax,0
ow_fi_ok:
	mov	v_fill_style,ax
	mov	ax,es:[di]                      ; intin[9] = fill style index
	add	di,2
	dec	ax
	cmp	ax,6
	jbe	ow_fs_ok
	mov	ax,0
ow_fs_ok:
	inc	ax
	mov	v_fill_index,ax
	mov	ax,es:[di]                      ; intin[10] = fill color
	call	sub_CD1h
	mov	v_fill_color,ax
	push	ds
	mov	ax,ds
	mov	es,ax
	mov	si,offset palette_defaults      ; copy 14 bytes within DATA
	mov	di,offset palette_requested
	mov	cx,00Eh
	rep movsb
	mov	ax,1
	mov	cx,5
	mov	di,offset v_device_input_mode
	rep stosb                               ; store 5×1 bytes
	pop	ds
	mov	word ptr locator_step_offset,0
	mov	cl,1
	jmp	init_graphics                   ; init graphics mode, return

; ============================================================================
; CLOSE WORKSTATION  CS:0153
; ============================================================================
op02_CLOSE_WORKSTATION:
	call	sub_FE8h
	jmp	exit_graphics

; ============================================================================
; CLEAR WORKSTATION  CS:0159
; Clears pixel memory to zero (16K words = 32KB).
; ============================================================================
op03_CLEAR_WORKSTATION:
	call	get_gcb_mutex
	mov	ax,gcb_seg                      ; gcb_seg -> pixel memory segment
	mov	es,ax
	mov	cx,04000h                       ; 16384 words = 32KB
	xor	ax,ax
	mov	di,ax
	rep stosw
	jmp	free_gcb_mutex

; ============================================================================
; UPDATE WORKSTATION  CS:016D
; No-op for this device (display updates immediately).
; ============================================================================
op04_UPDATE_WORKSTATION:
	ret

; ============================================================================
; ESCAPE  CS:016E
; Dispatches ESCAPE sub-functions via secondary jump table at DATA:0146.
; Sub-functions 0..0x13 (0..19) supported; higher -> ignore (ret).
; ============================================================================
op05_ESCAPE:
	mov	bx,es:0Ah[di]                   ; contrl[5]: GDP/ESCAPE subfunction
	cmp	bx,013h
	jbe	esc_dispatch
	ret

esc_dispatch:
	shl	bx,1
	jmp	word ptr esc_table[bx]          ; dispatch via escape sub-table

; Escape sub-function 0: DRIVER IDENTIFICATION  CS:017E
escfn0:
	mov	si,offset driver_identification
	lodsw
	mov	es:8[di],ax                     ; contrl[4]: output word count
	les	di,0Eh[bp]                      ; ES:DI -> intout[] (GSX stack frame +14)
	mov	cx,ax
	rep movsw
	ret

; Escape sub-function 1: INQUIRE ADDRESSABLE CHARACTER CELLS  CS:018E
escfn1:
	mov	es:8[di],word ptr 2             ; contrl[4]: output word count
	les	di,0Eh[bp]                      ; ES:DI -> intout[] (GSX stack frame +14)
	mov	es:word ptr [di],018h           ; display rows = 24
	mov	es:2[di],word ptr 050h          ; display columns = 80
	cmp	word ptr v_gfx_init,0
	je	escfn1_done
	mov	es:2[di],word ptr 050h
escfn1_done:
	ret

; Escape sub-function 2: ENTER GRAPHICS MODE AND CLEAR  CS:01B0
escfn2:
	call	init_graphics
	call	op03_CLEAR_WORKSTATION
	ret

; Escape sub-function 3: EXIT GRAPHICS MODE  CS:01B7
escfn3:
	jmp	exit_graphics

; Escape sub-function 4: CURSOR UP  CS:01BA
escfn4:
	mov	si,offset seq_cursor_up
	jmps	esc_send_seq

; Escape sub-function 5: CURSOR DOWN  CS:01BF
escfn5:
	mov	si,offset seq_cursor_down
	jmps	esc_send_seq

; Escape sub-function 6: CURSOR RIGHT  CS:01C4
escfn6:
	mov	si,offset seq_cursor_right
	jmps	esc_send_seq

; Escape sub-function 7: CURSOR LEFT  CS:01C9
escfn7:
	mov	si,offset seq_cursor_left
	jmps	esc_send_seq

; Escape sub-function 8: HOME CURSOR  CS:01CE
escfn8:
	mov	si,offset seq_cursor_home
	jmp	esc_send_seq

; Escape sub-function 9: ERASE TO END OF SCREEN  CS:01D4
escfn9:
	mov	si,offset seq_erase_screen
	jmps	esc_send_seq

; Escape sub-function 10: ERASE TO END OF LINE  CS:01D9
escf10:
	mov	si,offset seq_erase_line
	jmps	esc_send_seq

; Escape sub-function 11: DIRECT CURSOR ADDRESS  CS:01DE
escf11:
	les	di,6[bp]                        ; ES:DI -> intin[] (GSX stack frame +6)
	mov	ax,es:[di]
	add	ax,01Fh
	mov	v_cursor_x,ax
	mov	ax,es:2[di]
	add	ax,01Fh
	mov	v_cursor_y,ax
	mov	si,offset seq_cursor_address
	jmps	esc_send_seq

; Escape sub-function 12: OUTPUT ALPHANUMERIC TEXT  CS:01F9
escf12:
	mov	cx,es:6[di]                     ; contrl[3]: input word count
	add	v_marker_scale,cx
	les	si,6[bp]                        ; ES:SI -> intin[] (GSX stack frame +6)
	jmps	esc_send_seq_mid

; Escape sub-function 13: REVERSE VIDEO ON  CS:0206
escf13:
	mov	si,offset seq_reverse_on
	jmps	esc_send_seq

; Escape sub-function 14: REVERSE VIDEO OFF  CS:020B
escf14:
	mov	si,offset seq_reverse_off

; Common tail: send escape sequence from DS:SI  CS:020E
esc_send_seq:
	mov	ax,ds
	mov	es,ax
	lods	es:word ptr [si]
	xchg	cx,ax
esc_send_seq_mid:
	jcxz	esc_send_done
esc_send_loop:
	lods	es:word ptr [si]
	call	sub_FCCh
	loop	esc_send_loop
esc_send_done:
	ret

; Escape sub-function 15: INQUIRE CURRENT CURSOR ADDRESS  CS:021F
escf15:
	mov	es:8[di],word ptr 2             ; contrl[4]: output word count
	mov	al,016h
	int	028h                            ; XIOS fn 22: GetCursorPos
	les	di,0Eh[bp]                      ; ES:DI -> intout[] (GSX stack frame +14)
	mov	al,bh
	cbw
	mov	es:[di],ax
	mov	al,bl
	mov	es:2[di],ax
	ret

; Escape sub-function 16: INQUIRE INPUT-DEVICE STATUS  CS:0239
escf16:
	mov	es:8[di],word ptr 1             ; contrl[4]: output word count
	les	di,0Eh[bp]                      ; ES:DI -> intout[] (GSX stack frame +14)
	mov	es:word ptr [di],0
	ret

; Escape sub-function 17: HARDCOPY (STUB)  CS:0248
escf17:
	ret

; Escape sub-function 18: PLACE GRAPHIC CURSOR AT LOCATION  CS:0249
escf18:
	les	di,0Ah[bp]                      ; ES:DI -> ptsin[] (GSX stack frame +10)
	mov	ax,es:[di]
	mov	v_saved_x,ax
	mov	v_draw_x,ax
	mov	ax,es:2[di]
	mov	v_saved_y,ax
	mov	v_draw_y,ax
	jmps	sub_26Dh

; Escape sub-function 19: REMOVE SAVED XOR GRAPHIC CURSOR  CS:0261
escf19:
	mov	ax,v_saved_x
	mov	v_draw_x,ax
	mov	ax,v_saved_y
	mov	v_draw_y,ax

; Internal: draw XOR cursor at v_draw_x,v_draw_y  CS:026D
sub_26Dh:
	call	get_gcb_mutex
	mov	dx,3
	mov	bx,1
	call	load_pixel_lut
	mov	word ptr draw_pattern,0FFFFh
	mov	bx,v_draw_x
	mov	ax,022Fh
	call	sub_2C4h
	mov	v_x1,bx
	mov	v_y1,dx
	mov	bx,v_draw_y
	mov	v_x2,bx
	mov	v_y2,bx
	call	abline
	mov	bx,v_draw_y
	mov	ax,0FFh
	call	sub_2C4h
	mov	v_x2,bx
	mov	v_y2,dx
	mov	bx,v_draw_x
	mov	v_x1,bx
	mov	v_y1,bx
	call	abline
	jmp	free_gcb_mutex

; Internal: return cursor bounds max(BX-5,0)..min(BX+5,AX)  CS:02C4
sub_2C4h:
	mov	dx,bx
	add	dx,5
	cmp	dx,ax
	jb	sub_2C4h_hi_ok
	mov	dx,ax
sub_2C4h_hi_ok:
	sub	bx,5
	jae	sub_2C4h_lo_ok
	xor	bx,bx
sub_2C4h_lo_ok:
	ret

op06_POLYLINE:                                  ; CS:02D7h
	call	get_gcb_mutex
	mov	bx,v_linetype
	shl	bx,1
	mov	ax,word ptr line_type_base[bx]
	mov	draw_pattern,ax
	mov	dx,writing_mode
	mov	bx,v_line_color
	call	load_pixel_lut
	mov	word ptr v_polyline_state,0
	mov	cx,es:2[di]                     ; contrl[1]: input coordinate-pair count
	dec	cx
	cmp	cx,0
	jle	op06_done
op06_load_points:
	les	di,0Ah[bp]                      ; ES:DI -> ptsin[] (GSX stack frame +10)
op06_points:
	cmp	cx,1
	jne	op06_first_point
	mov	word ptr v_polyline_state,0FFh
op06_first_point:
	mov	ax,es:[di]
	mov	v_x1,ax
	mov	ax,es:2[di]
	mov	v_x2,ax
	add	di,4
op06_draw_segment:
	push	cx
	mov	ax,es:[di]
	mov	v_y1,ax
	mov	ax,es:2[di]
	mov	v_y2,ax
	call	abline
	pop	cx
	loop	op06_points
op06_done:
	jmp	free_gcb_mutex

sub_337h:
	cmp	byte ptr pixel_mode,3
	jne	sub_337_done
	cmp	word ptr v_polyline_state,0FFh
	je	sub_337_done
	cmp	cx,1
	je	sub_337_done
	dec	cx
sub_337_done:
	ret

abline:                                         ; CS:034Dh
	push	es
	push	si
	push	di
	mov	es,word ptr gcb_seg
	mov	cx,v_y1
	sub	cx,v_x1
	jb	sub_34d_y_decreases
	push	cx
	mov	bx,v_x1
	mov	dx,v_x2
	call	concat
	pop	cx
	mov	dx,v_y2
	sub	dx,v_x2
	jne	sub_34d_y_changes
	jmp	sub_34d_walk
sub_34d_y_decreases:
	push	cx
	mov	bx,v_y1
	mov	dx,v_y2
	call	concat
	pop	cx
	neg	cx
	mov	dx,v_x2
	sub	dx,v_y2
	jne	sub_34d_y_changes
	jmp	sub_34d_walk
sub_34d_y_changes:
	mov	word ptr v_line_step,0FFFEh
	jae	sub_34d_step_ready
	neg	dx
	mov	word ptr v_line_step,2
sub_34d_step_ready:
	cmp	cx,dx
	jae	sub_34d_x_major
	jmp	sub_34d_y_major
sub_34d_x_major:
	mov	ax,cx
	inc	cx
	call	sub_337h
	shl	dx,1
	mov	v_delta_major,dx
	sub	dx,ax
	mov	v_line_error,dx
	sub	word ptr v_line_error,ax
sub_34d_x_major_loop:
	call	plot_pixel
	ror	bx,1
	jae	sub_34d_x_loop
	add	di,0200h
sub_34d_x_loop:
	cmp	dx,0
	js	sub_34d_x_step_y
	add	dx,v_line_error
	add	di,v_line_step
	loop	sub_34d_x_major_loop
	jmp	sub_34d_done
sub_34d_x_step_y:
	add	dx,v_delta_major
	loop	sub_34d_x_major_loop
	jmp	sub_34d_done
sub_34d_y_major:
	xchg	cx,dx
	mov	ax,cx
	inc	cx
	call	sub_337h
	shl	dx,1
	mov	v_delta_major,dx
	sub	dx,ax
	mov	v_line_error,dx
	sub	word ptr v_line_error,ax
sub_34d_y_major_loop:
	call	plot_pixel
	add	di,v_line_step
	cmp	dx,0
	js	sub_34d_y_step_x
	ror	bx,1
	jae	sub_34d_y_add_error
	add	di,0200h
sub_34d_y_add_error:
	add	dx,v_line_error
	loop	sub_34d_y_major_loop
	jmps	sub_34d_done
sub_34d_y_step_x:
	add	dx,v_delta_major
	loop	sub_34d_y_major_loop
sub_34d_done:
	pop	di
	pop	si
	pop	es
	ret

sub_34d_single_pixel:
	mov	word ptr v_polyline_state,0FFh
	push	cx
	call	concat
	pop	cx
	push	es
	push	si
	push	di
	mov	es,word ptr gcb_seg
sub_34d_walk:
	inc	cx
	call	sub_337h
sub_34d_walk_loop:
	call	plot_pixel
	ror	bx,1
	jae	sub_34d_walk_next
	add	di,0200h
sub_34d_walk_next:
	loop	sub_34d_walk_loop
	jmps	sub_34d_done

; Toggle the pixel using a four-byte truth table selected by load_pixel_lut.
; Index = 2*pattern_bit + old_pixel; the byte is 00h or FFh.
plot_pixel:
	xor	si,si
	ror	word ptr draw_pattern,1
	adc	si,si
	shl	si,1
	mov	ax,es:[di]
	and	ax,bx
	add	ax,0FFFFh
	adc	si,word ptr pixel_lut
	mov	al,[si]
	mov	ah,al
	and	ax,bx
	xor	es:[di],ax
	ret

concat:
	mov	ax,0FFh
	sub	ax,dx
	mov	di,bx
	mov	cl,bl
	and	bx,0FFF0h
	mov	dx,bx
	shl	bx,1
	shl	bx,1
	shl	bx,1
	shl	bx,1
	add	bx,ax
	shl	bx,1
	and	di,0Fh
	xchg	bx,di
	shl	bx,1
	mov	bx,word ptr bit_masks[bx]
	ret

load_pixel_lut:                                 ; CS:0492h
	mov	pixel_mode,dl
	cmp	bx,2
	jb	sub_492_color_ok
	mov	bx,1
sub_492_color_ok:
	mov	dh,byte ptr pixel_color_control[bx]
	mov	bx,offset pixel_lut
	mov	cx,1
sub_492_loop:
	sar	dh,1
	mov	al,dl
	rcl	al,1
	shl	al,1
	shl	al,1
	xor	ah,ah
	add	ax,offset pixel_truth_tables
	mov	word ptr [bx],ax
	add	bx,2
	loop	sub_492_loop
	ret

op07_POLYMARKER:                                ; CS:04BFh
	call	get_gcb_mutex
	mov	ax,marker_sine
	mov	transform_sine,ax
	mov	ax,marker_cosine
	mov	transform_cosine,ax
	mov	ax,marker_scale
	mov	transform_scale,ax
	mov	draw_pattern,0FFFFh
	mov	dx,writing_mode
	mov	bx,v_marker_color
	call	load_pixel_lut
	mov	cx,es:word ptr 2[di]            ; contrl[1]: input coordinate-pair count
	jcxz	op07_done
	les	di,0Ah[bp]                      ; ES:DI -> ptsin[] (GSX stack frame +10)
op07_loop:
	mov	ax,es:word ptr [di]
	mov	v_draw_x,ax
	mov	ax,es:word ptr 2[di]
	mov	v_draw_y,ax
	add	di,4
	mov	ax,v_marker_type
	push	es
	push	di
	push	cx
	call	draw_vector_glyph
	pop	cx
	pop	di
	pop	es
	loop	op07_loop
op07_done:
	jmp	free_gcb_mutex

op08_TEXT:                                      ; CS:050Fh
	call	get_gcb_mutex
	mov	ax,text_sine
	mov	transform_sine,ax
	mov	ax,text_cosine
	mov	transform_cosine,ax
	mov	ax,text_scale
	mov	transform_scale,ax
	mov	draw_pattern,0FFFFh
	mov	dx,writing_mode
	mov	bx,v_text_color
	call	load_pixel_lut
	mov	cx,es:6[di]
	jcxz	op08_done
	les	di,0Ah[bp]                      ; ES:DI -> ptsin[] (GSX stack frame +10)
	mov	ax,es:[di]
	mov	v_text_x,ax
	mov	ax,es:2[di]
	mov	v_text_y,ax
	push	cx
	mov	cx,6
	shl	word ptr v_text_x,cl
	shl	word ptr v_text_y,cl
	mov	ax,ds
	mov	es,ax
	mov	di,offset v_text_dx
	mov	es:word ptr [di],8
	mov	es:word ptr 2[di],0
	call	transform_text_advance
	pop	cx
	les	di,6[bp]                        ; ES:DI -> intin[] (GSX stack frame +6)
op08_char_loop:
	mov	al,es:[di]
	cmp	al,7Fh
	jbe	op08_char_ready
	mov	al,20h
op08_char_ready:
	inc	di
	inc	di
	push	es
	push	di
	push	cx
	mov	cx,6
	mov	bx,v_text_x
	shr	bx,cl
	mov	v_draw_x,bx
	mov	bx,v_text_y
	shr	bx,cl
	mov	v_draw_y,bx
	call	draw_vector_glyph
	mov	ax,v_text_dx
	add	v_text_x,ax
	mov	ax,v_text_dy
	add	v_text_y,ax
	pop	cx
	pop	di
	pop	es
	loop	op08_char_loop
op08_done:
	jmp	free_gcb_mutex

	; Signed high/low nibbles encode x/y; 80h splits strokes, 88h ends.
	; Marker 2 starts D0h,30h -> (-3,0),(3,0), then a separate stroke.
draw_vector_glyph:                              ; CS:05AEh
	xor	ah,ah
	shl	ax,1
	mov	si,ax
	mov	si,word ptr glyph_offsets[si]
sub_5AE_restart:
	mov	word ptr v_text_point_count,0
	mov	di,offset v_text_points
	mov	ax,ds
	mov	es,ax
sub_5AE_next:
	lodsb
	cmp	al,88h
	je	draw_glyph_stroke
	cmp	al,80h
	jne	sub_5AE_decode
	call	draw_glyph_stroke
	jmps	sub_5AE_restart
sub_5AE_decode:
	mov	bl,al
	and	ax,000Fh
	test	al,8
	je	sub_5AE_y_ready
	or	ax,0FFF0h
sub_5AE_y_ready:
