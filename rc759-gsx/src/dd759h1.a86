	les	di,2[bp]
	mov	es:4[di],cx
	mov	es:8[di],bx
	ret
op28_alternate_mode:
	call	get_loc_key
	or	al,al
	je	op28_no_event
	cmp	al,2
	je	op28_mode_key
	mov	bx,1
	jmps	op28_return_zero
op28_mode_key:
	push	ax
	call	clamp_locator
	pop	ax
	xor	bx,bx
	jmps	op28_return_one
op28_no_event:
	xor	bx,bx
op28_return_zero:
	xor	cx,cx
	jmps	op28_return_data
get_loc_key:
	call	sub_FB8h
	or	al,al
	je	sub_DB3_empty
	xchg	ah,al
	mov	al,2
	mov	si,0
	cmp	ah,0C8h
	je	sub_DB3_decode
	mov	si,8
	cmp	ah,0D0h
	je	sub_DB3_decode
	mov	si,10h
	cmp	ah,0CDh
	je	sub_DB3_decode
	mov	si,18h
	cmp	ah,0CBh
	je	sub_DB3_decode
	cmp	ah,0C9h
	je	sub_DB3_toggle
	mov	al,1
	ret
sub_DB3_toggle:
	xor	word ptr locator_step_offset,4
sub_DB3_empty:
	xor	ax,ax
	ret
sub_DB3_decode:
	add	si,locator_step_offset
	mov	bx,word ptr 02B2h[si]
	inc	si
	inc	si
	mov	cx,word ptr 02B2h[si]
	add	bx,v_draw_x
	add	cx,v_draw_y
	xor	ah,ah
	ret
clamp_locator:
	mov	v_draw_x,bx
	mov	v_draw_y,cx
	mov	ax,022Fh
	cmp	v_draw_x,ax
	jle	sub_E08_x_max_ready
	mov	v_draw_x,ax
sub_E08_x_max_ready:
	cmp	word ptr v_draw_x,0
	jge	sub_E08_x_min_ready
	mov	word ptr v_draw_x,0
sub_E08_x_min_ready:
	mov	ax,0FFh
	cmp	v_draw_y,ax
	jle	sub_E08_y_max_ready
	mov	v_draw_y,ax
sub_E08_y_max_ready:
	cmp	word ptr v_draw_y,0
	jge	sub_E08_y_min_ready
	mov	word ptr v_draw_y,0
sub_E08_y_min_ready:
	xor	ax,ax
	or	ax,ax
	ret

op29_VALUATOR:				; CS:0E47h
	les	di,6[bp]
	mov	cx,es:2[di]
	cmp	byte ptr v_input_mode,1
	jne	op29_alternate_mode
op29_read_loop:
	push	cx
	call	sub_FB0h
	pop	cx
	call	sub_E87h
	je	op29_read_loop
	mov	bx,1
op29_return:
	les	di,0Eh[bp]
	mov	es:word ptr [di],cx
	les	di,2[bp]
	mov	es:8[di],bx
	ret
op29_alternate_mode:
	call	sub_FB8h
	mov	bx,0
	or	al,al
	je	op29_return
	call	sub_E87h
	mov	bx,1
	je	op29_return
	mov	bx,0
	jmps	op29_return
sub_E87h:
	cmp	al,2Bh
	jne	sub_E87_not_plus
	inc	cx
	jmps	sub_E87_done
sub_E87_not_plus:
	cmp	al,2Dh
	jne	sub_E87_other
	dec	cx
	xor	ax,ax
sub_E87_other:
	or	ax,ax
sub_E87_done:
	ret

op30_CHOICE:				; CS:0E98h
	call	sub_FDEh
	mov	es:8[di],word ptr 0
	cmp	byte ptr v_key_mode,1
	je	op30_secondary_input
	call	sub_FB8h
	or	al,al
	je	op30_return
	mov	bx,1
	jns	op30_return
	sub	al,0BAh
	cbw
	mov	cx,ax
	cmp	ax,1
	jb	op30_invalid_key
	cmp	ax,0Ch
	jbe	op30_report
op30_invalid_key:
	mov	cx,0
op30_report:
	les	di,2[bp]
	mov	es:8[di],bx
	les	di,0Eh[bp]
	mov	es:word ptr [di],cx
op30_return:
	ret
op30_secondary_input:
	call	sub_FB0h
	or	al,al
	jns	op30_secondary_empty
	mov	bx,1
	sub	al,0BAh
	cbw
	mov	cx,ax
	cmp	ax,1
	jb	op30_secondary_empty
	cmp	ax,0Ch
	jbe	op30_report
op30_secondary_empty:
	mov	cx,0
	mov	bx,0
	jmps	op30_report

op31_STRING:				; CS:0EF5h
	les	di,6[bp]
	mov	cx,es:2[di]
	mov	ax,es:4[di]
	les	di,0Eh[bp]
	xor	bx,bx
	or	ax,ax
	je	op31_default_input
op31_mode_dispatch:
	cmp	byte ptr v_keyboard_mode,1
	je	op31_keyboard_input
op31_console_input:
	call	sub_FB8h
	or	al,al
	je	op31_done
	xor	ah,ah
	stosw
	inc	bx
	call	sub_FCCh
	loop	op31_console_input
	jmps	op31_done
op31_keyboard_input:
	call	sub_FC9h
	cmp	al,0Dh
	je	op31_done
	xor	ah,ah
	stosw
	inc	bx
	loop	op31_mode_dispatch
	jmps	op31_done
op31_default_input:
	cmp	byte ptr v_keyboard_mode,1
	je	op31_default_keyboard
op31_default_console:
	call	sub_FB8h
	or	al,al
	je	op31_done
	xor	ah,ah
	stosw
	inc	bx
	loop	op31_default_console
	jmps	op31_done
op31_default_keyboard:
	call	sub_FB0h
	cmp	al,0Dh
	je	op31_done
	xor	ah,ah
	stosw
	inc	bx
	loop	op31_default_keyboard
op31_done:
	les	di,2[bp]
	mov	es:8[di],bx
	ret

op32_SET_WRITING_MODE:		; CS:0F5Ch
	mov	es:8[di],word ptr 1
	les	di,6[bp]
	mov	bx,es:[di]
	mov	ax,1
	cmp	bx,0
	je	op32_value_ready
	cmp	bx,4
	ja	op32_value_ready
	mov	ax,bx
op32_value_ready:
	les	di,0Eh[bp]
	mov	writing_mode,ax
	mov	es:word ptr [di],ax
	ret

op33_SET_INPUT_MODE:		; CS:0F81h
	mov	es:8[di],word ptr 1
	les	di,6[bp]
	mov	bx,es:[di]
	mov	ax,es:2[di]
	cmp	ax,2
	je	op33_mode_ready
	mov	ax,1
op33_mode_ready:
	mov	si,02ABh
	cmp	bx,4
	jbe	op33_index_ready
	mov	bx,0
op33_index_ready:
	add	si,bx
	mov	[si],al
	les	di,0Eh[bp]
	mov	es:word ptr [di],ax
	ret

op34_INQUIRE_INPUT_MODE:	; CS:0FAFh
	ret

sub_FB0h:
	call	sub_FB8h
	or	al,al
	je	sub_FB0h
	ret

sub_FB8h:
	push	es
	push	di
	push	dx
	push	cx
	push	bx
	mov	dl,0FFh
	mov	cl,6
	int	0E0h
	pop	bx
	pop	cx
	pop	dx
	pop	di
	pop	es
	ret

sub_FC9h:
	call	sub_FB0h
sub_FCCh:			; CS:0FCCh
	push	ax
	push	es
	push	di
	push	cx
	push	bx
	mov	dl,al
	mov	cx,6
	int	0E0h
	pop	bx
	pop	cx
	pop	di
	pop	es
	pop	ax

op00_invalid:			; CS:0FDDh
	ret

sub_FDEh:
	mov	al,1Bh
	call	sub_FCCh
	mov	al,36h
	jmp	sub_FCCh

sub_FE8h:			; CS:0FE8h
	mov	al,1Bh
	call	sub_FCCh
	mov	al,37h
	jmp	sub_FCCh

get_gcb_mutex:			; CS:0FF2h
	mov	al,0FFh
	xchg	byte ptr gcb_mx,al
	test	al,al
	je	sub_FF2_done
sub_FF2_wait:
	push	di
	push	bp
	push	es
	mov	cl,8Dh
	mov	dx,1
	int	0E0h
	pop	es
	pop	bp
	pop	di
	jmps	get_gcb_mutex
sub_FF2_done:
	ret

free_gcb_mutex:			; CS:0100Ch
	mov	byte ptr gcb_mx,0
	ret

init_graphics:			; CS:01012h
	; Keep both segment operands relocatable; their linked bytes are zero.
	mov	word ptr gcb_seg,SEG extra_segment_anchor
	mov	al,0
	mov	ah,1
	mov	dx,SEG gcb_seg
	mov	cx,058Ch
	int	028h
	mov	word ptr v_gfx_init,1
	ret

exit_graphics:			; CS:0102Bh
	mov	al,1
	int	028h
	mov	word ptr v_gfx_init,0
	ret

	rb	10		; CODE trailing padding

