; Signed-nibble vectors; 128 splits strokes, 136 ends a glyph.
; Sketches: o = vertex, # = schematic line, . = empty; Y upwards.
; Integer line sketches are not the driver rasterization oracle.

; Stroke 1: (-7,0) -> (-1,0)
; Stroke 2: (1,0) -> (7,0)
; Stroke 3: (0,-7) -> (0,-1)
; Stroke 4: (0,1) -> (0,7)
; Sketch: X=-7..7, Y=7..-7 (top to bottom).
; .......o.......
; .......#.......
; .......#.......
; .......#.......
; .......#.......
; .......#.......
; .......o.......
; o#####o.o#####o
; .......o.......
; .......#.......
; .......#.......
; .......#.......
; .......#.......
; .......#.......
; .......o.......
glyph_000:
	db	090h,0F0h,080h,010h,070h,080h,009h,00Fh,080h,001h,007h,088h

