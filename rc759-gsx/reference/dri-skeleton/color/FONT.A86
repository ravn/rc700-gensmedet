	db	0ddh
	db	0aah
	db	77h
;
	db	0aah		;intensity level twelve
	db	0ffh
	db	0aah
	db	0ffh
;
	db	0eeh		;intensity level fourteen
	db	0ffh
	db	0bbh
	db	0ffh
;
	db	0ffh		;intensity level sixteen
	db	0ffh
	db	0ffh
	db	0ffh
;
