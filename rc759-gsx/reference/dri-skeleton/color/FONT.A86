;
;******************************************************************************
;ENGLISH
;Bit mapped Font (1603)
;	Derived from TV-910 terminal font
;		this is special for graphics
;		actual display will be reflected like mirror 
;
;Last Update March 11,1982 11:56 A.M.
;1/5/82 Modified area styles (dithered and cross-hatched)		
;	changed area style bytes according to a rotate left
;	rather than right for ease in fast fill algorithm
;	Used in 803 where MSB of graphic mem. byte is left most
;	bit in screen.		
;1/26/83 Made first two crosshatch patterns twice as dense. 
;1/28/83 Made A "dot" as the first marker.
;3/8/83  The area styles (pattern and crosshatch are mirrored)
;	 The actual characters, markers and ctrl characters are normal.
;3/10/83 The vertical and horizontal cross-hatch made twice as dense.
;6/17/83 Rearranged the Fill PATTERN styles to be the same as the TS803
;8/20/83 added dseg to put this stuff in the data segment
;8/25/83 added jump to entry to allow module to be linked first
;8/28/83 moved the first byte to the last byte like it is supposed to be
;******************************************************************************
public	font,arstl1
cseg	
	extrn	entry:near
	jmp	entry			;jump to entry if this is the first
					;module in the link command
dseg
font	db	00h,00h,00h,00h ;NULL
	db	00h,00h,00h,00h ;
	db	05h,70h,40h,70h ;SOH
	db	15h,75h,07h,05h ;
	db	05h,70h,40h,70h ;STX
	db	15h,75h,02h,05h ;
	db	05h,70h,40h,60h ;ETX
	db	45h,75h,02h,05h ;

;
;area style tables
;
