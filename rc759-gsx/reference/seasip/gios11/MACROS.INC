;
; Macros for overlong forms of opcodes, generated by whatever the 
; original assembler did.
;
CodeMacro SAXW	param:Mw	;Overlong MOV [param],AX
	db	89h
	db	06h
	dw	param
EndM

CodeMacro LAXW	param:Mw	;Overlong MOV AX,[param]
	db	8Bh
	db	06h
	dw	param
EndM

CodeMacro ADDAXW param:D	;Overlong ADD AX, param
	db	81h	
	db	0C0h
	dw	param
EndM

CodeMacro SUBAXW param:D	;Overlong SUB AX, param
	db	81h	
	db	0E8h
	dw	param
EndM

CodeMacro ANDAXW param:D	;Overlong AND AX, param
	db	81h	
	db	0E0h
	dw	param
EndM

CodeMacro ADDSIW param:D	;Overlong ADD SI, param
	db	81h	
	db	0C6h
	dw	param
EndM

CodeMacro SUBSIW param:D	;Overlong SUB SI, param
	db	81h	
	db	0EEh
	dw	param
EndM

CodeMacro ADDPSI param:D	;Overlong ADD word ptr [si], param
	db	81h	
	db	04h
	dw	param
EndM

CodeMacro SUBPSI param:D	;Overlong SUB word ptr [si], param
	db	81h	
	db	2Ch
	dw	param
EndM

CodeMacro ADDPDI		;Overlong ADD DI, CS:0[DI]
	db	2Eh
	db	03h
	db	0BDh
	dw	0
EndM

CodeMacro MOVSIAX		;Alternative encoding of MOV SI,AX
	db	89h
	db	0C6h
EndM

CodeMacro MOVAXSI		;Alternative encoding of MOV AX,SI
	db	89h
	db	0F0h
EndM


