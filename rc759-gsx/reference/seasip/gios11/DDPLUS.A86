	db	1Ah
	db	08h, 10h, 11h, 0Eh, 00h, 0Eh, 11h, 10h, 08h, 04h, 08h, 1Fh
	db	00h, 08h, 08h, 1Fh, 09h, 0Ah, 0Ch, 08h, 00h, 0Eh, 11h, 10h
	db	10h, 0Fh, 01h, 1Fh, 00h, 0Eh, 11h, 11h, 0Eh, 02h, 04h, 08h
	db	00h, 02h, 02h, 04h, 08h, 10h, 10h, 1Fh, 00h, 0Eh, 11h, 11h
	db	0Eh, 11h, 11h, 0Eh, 00h, 02h, 04h, 08h, 0Eh, 11h, 11h, 0Eh
	db	00h, 06h, 06h, 00h, 00h, 06h, 06h, 00h, 02h, 04h, 06h, 06h
	db	00h, 06h, 06h, 00h, 00h, 08h, 04h, 02h, 01h, 02h, 04h, 08h
	db	00h, 00h, 00h, 1Fh, 00h, 1Fh, 00h, 00h, 00h, 02h, 04h, 08h
	db	10h, 08h, 04h, 02h, 00h, 04h, 00h, 04h, 08h, 10h, 11h


