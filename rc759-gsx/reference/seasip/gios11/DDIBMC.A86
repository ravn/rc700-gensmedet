
XRESMX		equ	319	; X - maximum resolution
YRESMX		equ	199	; Y - maximum resolution
XSIZE		equ	756	; Pixel width
YSIZE		equ	900	; Pixel height
CROSSHAIR_W	equ	4	; Crosshair width
CROSSHAIR_H	equ	4	; Crosshair height
MARK2_SIZE	equ	4	; Marker 2 size

NUM_COLORS	equ	4	; Colour depth
TWOHEAD		equ	0	; Graphice and text are separate 'heads'?
NEEDSFLUSH	equ	0	; 'Flush' function needs callling after draw?


GRAPH_PLANE	equ	0B800h
PLANE_SIZE	equ	02000h

		include	macros.inc
		include	common0.inc
		include	common1.inc
		include	font.inc
		include	common2.inc

		cseg

gfxmode_regs	db	38h, 28h, 2Dh, 0Ah, 7Fh, 6, 64h, 70h, 2, 1, 6, 7
		db	0, 0, 0, 0
txtmode_regs	db	71h, 50h, 5Ah, 0Ah, 1Fh, 6, 19h, 1Ch, 2, 7, 6, 7
		db	0, 0, 0, 0
bitmasks	db	0C0h, 30h, 0Ch, 03h

write_ops	dw	offset write_replace
		dw	offset write_or
		dw	offset write_xor
		dw	offset write_erase



;		S u b r	o u t i	n e
; Enter	with 1 for graphics, 0 for text

gfxmode_param	equ	(byte ptr (4))[bp]

_GFXMODE:		; CODE XREF: v_opnwk+233p v_clswk+3p
					; ...
		push	bp
		mov	bp, sp
		push	es
		push	ds
		pushf	
		push	cs
		pop	ds
	
		cld	
		mov	dx, 3D8h	; Video	off
		xor	al, al
		out	dx, al
		mov	dx, 3D4h	; CRTC
		cmp	gfxmode_param, 0
		jz	set_textmode
		mov	si, offset gfxmode_regs
		xor	bl, bl
		mov	cx, 10h

init_crtc_g:				; CODE XREF: _GFXMODE+29j
		mov	al, bl
		inc	bl
		out	dx, al		; Video: CRT cntrlr addr
					; horizontal total
		inc	dx
		lodsb
		out	dx, al		; Video: CRT controller	internal registers
		dec	dx
		loop	init_crtc_g
		add	dx, 4
		mov	al, 2Ah		; Control reg (gfx mode)
		out	dx, al
		call	CLEARMEM
		mov	dx, 3D9h
		mov	al, 0		; Colour reg (gfx mode)
		out	dx, al
		jmp	gfxmode_end


set_textmode:				; CODE XREF: _GFXMODE+16j
		mov	si, offset txtmode_regs
		xor	bl, bl
		mov	cx, 10h

init_crtc_t:				; CODE XREF: _GFXMODE+4Cj
		mov	al, bl
		inc	bl
		out	dx, al
		inc	dx
		lodsb
		out	dx, al
		dec	dx
		loop	init_crtc_t
		call	_cleartext
		add	dx, 4
		mov	al, 29h		; Control reg for text mode
		out	dx, al
		inc	dx
		mov	al, 30h		; Colour reg for text mode
		out	dx, al

gfxmode_end:				; CODE XREF: _GFXMODE+38j
		popf	
		pop	ds
	
		pop	es
		pop	bp
		retn	





;		S u b r	o u t i	n e

CLEARMEM:		; CODE XREF: v_opnwk+238p v_clrwkp
					; ...
		push	es
		pushf	
		cld	
		mov	bx, GRAPH_PLANE
		mov	es, bx
	
		mov	cx, PLANE_SIZE
		xor	di, di
		xor	ax, ax
		rep stosw
		popf	
		pop	es
	
		retn	





;		S u b r	o u t i	n e

_cleartext:		; CODE XREF: v_enter_cur+8p
					; _GFXMODE+4Ep
		push	es
		pushf	
		cld	
		mov	bx, GRAPH_PLANE
		mov	es, bx
	
		mov	cx, PLANE_SIZE
		xor	di, di
		mov	ax, 720h
		rep stosw
		popf	
		pop	es
	
		retn	



fill_hline_mode	equ	(word ptr (16))[bp]
fill_hline_ink	equ	(word ptr (14))[bp]
fill_hline_rot	equ	(byte ptr (12))[bp]
fill_hline_mask	equ	(word ptr (10))[bp]
fill_hline_y	equ	(word ptr  (8))[bp]
fill_hline_x1	equ	(word ptr  (6))[bp]
fill_hline_x0	equ	(word ptr  (4))[bp]

;		S u b r	o u t i	n e

_fill_hline:		; CODE XREF: v_bar+A7p	area_fill+2DBp
		push	bp
		mov	bp, sp
		mov	dx, fill_hline_mask
		mov	cl, fill_hline_rot
		rol	dx, cl
		mov	cx, fill_hline_x1
		mov	bx, fill_hline_x0
		sub	cx, bx
		inc	cx

fill_hline1:				; CODE XREF: _fill_hline+37j
		push	cx
		push	bx
		push	dx
		push	word ptr fill_hline_mode
		xor	si, si
		mov	ah, dh
		and	ah, 80h
		jz	fill_hline2
		mov	si, fill_hline_ink

fill_hline2:				; CODE XREF: _fill_hline+21j
		push	si
		push	word ptr fill_hline_y
		push	bx
		call	_PUTPIXEL
		add	sp, 8
		pop	dx
		rol	dx, 1
		pop	bx
		inc	bx
		pop	cx
		loop	fill_hline1
		pop	bp
		retn	


getpixel_y	equ	(word ptr (6))[bp]
getpixel_x	equ	(word ptr (4))[bp]


_GETPIXEL:		; CODE XREF: vq_cellarray+125p
		push	bp
		mov	bp, sp
		push	ds
		mov	ax, YRESMX
		sub	ax, getpixel_y
		xor	dl, dl
		mov	dh, al
		and	dh, 1
		shl	dh, 1
		shl	dh, 1
		shl	dh, 1
		shl	dh, 1
		shl	dh, 1
		mov	di, dx
		shr	ax, 1
		shl	ax, 1
		shl	ax, 1
		shl	ax, 1
		shl	ax, 1
		add	di, ax
		shl	ax, 1
		shl	ax, 1
		add	di, ax
		mov	ax, getpixel_x
		mov	si, ax
		shr	ax, 1
		shr	ax, 1
		add	di, ax
		and	si, 3
		mov	bl, cs:bitmasks[si]
		mov	cx, 3
		sub	cx, si
		shl	cl, 1
		xor	ah, ah
		mov	si, GRAPH_PLANE
		mov	ds, si
	
		mov	al, [di]
		and	al, bl
		shr	al, cl
		pop	ds
		pop	bp
		retn	



putpixel_mode	equ	(word ptr (10))[bp]
putpixel_ink	equ	(word ptr  (8))[bp]
putpixel_y	equ	(word ptr  (6))[bp]
putpixel_x	equ	(word ptr  (4))[bp]

;		S u b r	o u t i	n e

_PUTPIXEL:		; CODE XREF: v_cellarray+1A2p
					; cseg:12ADp ...
		push	bp
		mov	bp, sp
		push	ds
		mov	ax, YRESMX
		sub	ax, putpixel_y
		xor	dl, dl
		mov	dh, al
		and	dh, 1
		shl	dh, 1
		shl	dh, 1
		shl	dh, 1
		shl	dh, 1
		shl	dh, 1
		mov	di, dx
		shr	ax, 1
		shl	ax, 1
		shl	ax, 1
		shl	ax, 1
		shl	ax, 1
		add	di, ax
		shl	ax, 1
		shl	ax, 1
		add	di, ax
		mov	ax, putpixel_x
		mov	si, ax
		shr	ax, 1
		shr	ax, 1
		add	di, ax
		and	si, 3
		mov	bl, cs:bitmasks[si]
		mov	cx, 3
		sub	cx, si
		shl	cl, 1
		mov	dx, putpixel_ink
		shl	dl, cl
		mov	si, putpixel_mode
		dec	si
		shl	si, 1
		mov	ax, GRAPH_PLANE
		mov	ds, ax
	
		jmp	cs:write_ops[si]


write_replace:				; DATA XREF: cseg:2914o
		not	bl
		and	[di], bl
		or	[di], dl
		pop	ds
		pop	bp
		retn	


write_or:				; CODE XREF: _PUTPIXEL+55u
					; DATA XREF: cseg:2916o
		or	[di], dl
		pop	ds
		pop	bp
		retn	


write_xor:				; CODE XREF: _PUTPIXEL+55u
					; DATA XREF: cseg:2918o
		xor	[di], dl
		pop	ds
		pop	bp
		retn	


write_erase:				; CODE XREF: _PUTPIXEL+55u
					; DATA XREF: cseg:291Ao
		not	dl
		and	[di], dl
		pop	ds
		pop	bp
		retn	


		include	common3.inc

	dseg

